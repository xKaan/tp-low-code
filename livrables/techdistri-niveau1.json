{
  "name": "TechDistri - Niveau 1 - Centralisation Emails",
  "nodes": [
    {
      "id": "1",
      "name": "IMAP - Nouveau Mail",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "read",
        "options": {},
        "pollTimes": {
          "item": [
            { "mode": "everyX", "unit": "minutes", "value": 5 }
          ]
        }
      },
      "credentials": {
        "imap": { "id": "1", "name": "Gmail IMAP - Boîte Test TechDistri" }
      }
    },
    {
      "id": "2",
      "name": "Extraire Champs Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map((item) => {\n  const fromRaw = item.json.from;\n  let emailAddress = '';\n  if (fromRaw && typeof fromRaw === 'object' && fromRaw.value && fromRaw.value[0]) {\n    emailAddress = fromRaw.value[0].address || '';\n  } else if (typeof fromRaw === 'string') {\n    emailAddress = fromRaw;\n  }\n  emailAddress = emailAddress.trim().toLowerCase();\n\n  const atIndex = emailAddress.lastIndexOf('@');\n  const domaine = atIndex > -1 && atIndex < emailAddress.length - 1\n    ? emailAddress.slice(atIndex + 1)\n    : 'inconnu';\n\n  return {\n    json: {\n      expediteur: emailAddress || 'inconnu@inconnu.local',\n      domaine,\n      sujet: item.json.subject || '(sans sujet)',\n      date: item.json.date || new Date().toISOString(),\n      corps: item.json.textPlain || item.json.text || '',\n      messageId: item.json.messageId || item.json['message-id'] || '',\n    },\n  };\n});"
      }
    },
    {
      "id": "3",
      "name": "Airtable - Rechercher Client",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [680, 300],
      "parameters": {
        "operation": "list",
        "application": "__AIRTABLE_BASE_ID__",
        "table": "Clients",
        "returnAll": false,
        "limit": 1,
        "additionalOptions": {
          "filterByFormula": "={{ \"LOWER({Domaine email}) = '\" + $json.domaine + \"'\" }}"
        }
      },
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "2", "name": "Airtable - TechDistri (PAT)" }
      }
    },
    {
      "id": "4",
      "name": "Vérifier Client Trouvé",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "jsCode": "const searchResults = $input.all();\nconst emailData = $('Extraire Champs Email').first().json;\n\nif (searchResults.length > 0 && searchResults[0].json.id) {\n  return [{\n    json: {\n      clientId: searchResults[0].json.id,\n      isNew: false,\n      domaine: emailData.domaine,\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    clientId: null,\n    isNew: true,\n    domaine: emailData.domaine,\n  },\n}];"
      }
    },
    {
      "id": "5",
      "name": "Client Existe ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1120, 300],
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{ $json.isNew }}", "value2": true }
          ]
        }
      }
    },
    {
      "id": "6",
      "name": "Préparer Données Client",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 180],
      "parameters": {
        "jsCode": "const emailData = $('Extraire Champs Email').first().json;\nreturn [{\n  json: {\n    'Nom': emailData.domaine,\n    'Domaine email': emailData.domaine,\n    'Date création': new Date().toISOString(),\n  },\n}];"
      }
    },
    {
      "id": "7",
      "name": "Airtable - Créer Client",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [1560, 180],
      "parameters": {
        "operation": "append",
        "application": "__AIRTABLE_BASE_ID__",
        "table": "Clients",
        "addAllFields": true,
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": { "id": "2", "name": "Airtable - TechDistri (PAT)" }
      }
    },
    {
      "id": "8",
      "name": "Normaliser Client Créé",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 180],
      "parameters": {
        "jsCode": "const created = $input.first().json;\nconst emailData = $('Extraire Champs Email').first().json;\nreturn [{\n  json: {\n    clientId: created.id,\n    domaine: emailData.domaine,\n  },\n}];"
      }
    },
    {
      "id": "9",
      "name": "Préparer Données Mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300],
      "parameters": {
        "jsCode": "const clientInfo = $input.first().json;\nconst emailData = $('Extraire Champs Email').first().json;\n\nreturn [{\n  json: {\n    'Sujet': emailData.sujet,\n    'Expéditeur': emailData.expediteur,\n    'Date': emailData.date,\n    'Corps': emailData.corps,\n    'Message-ID': emailData.messageId,\n    'Statut traitement': 'Nouveau',\n    'Client': [clientInfo.clientId],\n  },\n}];"
      }
    },
    {
      "id": "10",
      "name": "Airtable - Créer Fiche Mail",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [2220, 300],
      "parameters": {
        "operation": "append",
        "application": "__AIRTABLE_BASE_ID__",
        "table": "Mails",
        "addAllFields": true,
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": { "id": "2", "name": "Airtable - TechDistri (PAT)" }
      }
    }
  ],
  "connections": {
    "IMAP - Nouveau Mail": {
      "main": [[{ "node": "Extraire Champs Email", "type": "main", "index": 0 }]]
    },
    "Extraire Champs Email": {
