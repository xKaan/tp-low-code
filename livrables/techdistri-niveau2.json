    {
      "id": "11",
      "name": "Extraire Pièces Jointes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3100, 300],
      "parameters": {
        "jsCode": "const mailRecord = $input.first().json;\nconst emailData = $('Un mail à la fois').first().json;\nconst binary = $('Un mail à la fois').first().binary || {};\n\nconst toBytes = (size) => {\n  const m = String(size || '').match(/([\\d.,]+)\\s*(B|kB|KB|MB|GB)?/);\n  if (!m) return 0;\n  const units = { B: 1, kB: 1e3, KB: 1e3, MB: 1e6, GB: 1e9 };\n  return Math.round(parseFloat(m[1].replace(',', '.')) * (units[m[2]] || 1));\n};\n\nreturn Object.keys(binary).map((key) => {\n  const bin = binary[key];\n  return {\n    json: {\n      mailId: mailRecord.id,\n      domaine: emailData.domaine,\n      fileName: bin.fileName || key,\n      mimeType: bin.mimeType || 'application/octet-stream',\n      fileSize: toBytes(bin.fileSize),\n    },\n    binary: { data: bin },\n  };\n});"
      }
    },
    {
      "id": "12",
      "name": "Drive - Chercher Dossier Client",
      "type": "n8n-nodes-base.googleDrive",
      "executeOnce": true,
      "typeVersion": 3,
      "position": [3320, 300],
      "alwaysOutputData": true,
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "={{ \"name='\" + $json.domaine + \"' and mimeType='application/vnd.google-apps.folder' and '__GDRIVE_ROOT_FOLDER_ID__' in parents and trashed=false\" }}",
        "filter": {},
        "options": {},
        "limit": 1
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "4",
          "name": "Google Drive - TechDistri"
