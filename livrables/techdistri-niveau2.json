    {
      "id": "22",
      "name": "Un mail à la fois",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [570, 480],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
