        "jsCode": "const found = $input.first().json.id;\nconst domaine = $('Extraire Pièces Jointes').first().json.domaine;\n\nreturn [{\n  json: {\n    domaine,\n    folderExists: !!found,\n    folderId: found || null,\n  },\n}];"
      }
    },
