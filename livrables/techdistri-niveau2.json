      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 300],
      "parameters": {
        "jsCode": "const clientInfo = $input.first().json;\nconst emailData = $('Un mail à la fois').first().json;\n\nreturn [{\n  json: {\n    'Sujet': emailData.sujet,\n    'Expéditeur': emailData.expediteur,\n    'Date': emailData.date,\n    'Corps': emailData.corps,\n    'Message-ID': emailData.messageId,\n    'Statut traitement': 'Nouveau',\n    'Client': [clientInfo.clientId],\n  },\n}];"
