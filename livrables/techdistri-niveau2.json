      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4860, 180],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const uploaded = $input.item.json;\nconst att = $('Préparer Uploads').item.json;\n\nreturn {\n  json: {\n    'Nom du fichier': att.fileName,\n    'Type MIME': att.mimeType,\n    'Taille (octets)': Number(uploaded.size) || att.fileSize,\n    'URL cloud': uploaded.webViewLink || uploaded.webContentLink || '',\n    \"Date d'arrivée\": new Date().toISOString(),\n    'Statut upload': 'Uploadé',\n    'Erreur': '',\n    'Mail': [att.mailId],\n  },\n};"
      }
    },
