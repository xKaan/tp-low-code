    {
      "id": "2",
      "name": "Extraire Champs Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map((item) => {\n  const fromRaw = item.json.from;\n  let emailAddress = '';\n  if (fromRaw && typeof fromRaw === 'object' && fromRaw.value && fromRaw.value[0]) {\n    emailAddress = fromRaw.value[0].address || '';\n  } else if (typeof fromRaw === 'string') {\n    const match = fromRaw.match(/<([^>]+)>/);\n    emailAddress = match ? match[1] : fromRaw;\n  }\n  const bracketed = emailAddress.match(/<([^>]+)>/);\n  if (bracketed) emailAddress = bracketed[1];\n  emailAddress = emailAddress.trim().toLowerCase();\n\n  const atIndex = emailAddress.lastIndexOf('@');\n  const domaine = atIndex > -1 && atIndex < emailAddress.length - 1\n    ? emailAddress.slice(atIndex + 1).replace(/[^a-z0-9.-]/g, '') || 'inconnu'\n    : 'inconnu';\n\n  return {\n    json: {\n      expediteur: emailAddress || 'inconnu@inconnu.local',\n      domaine,\n      sujet: item.json.subject || '(sans sujet)',\n      date: item.json.date || new Date().toISOString(),\n      corps: item.json.textPlain || item.json.text || '',\n      messageId: item.json.messageId || item.json['message-id'] || '',\n    },\n    binary: item.binary,\n  };\n});"
      }
    },
    {
      "id": "3",
      "name": "Airtable - Rechercher Client",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [1340, 300],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "list",
        "application": "__AIRTABLE_BASE_ID__",
        "table": "Clients",
        "returnAll": false,
        "limit": 1,
        "additionalOptions": {
          "filterByFormula": "={{ \"LOWER({Domaine email}) = '\" + $('Un mail à la fois').first().json.domaine.replace(/'/g, '') + \"'\" }}"
        }
      },
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": {
          "id": "2",
          "name": "Airtable - TechDistri (PAT)"
        }
      }
    },
    {
      "id": "4",
      "name": "Vérifier Client Trouvé",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300],
      "parameters": {
        "jsCode": "const searchResults = $input.all();\nconst emailData = $('Un mail à la fois').first().json;\n\nif (searchResults.length > 0 && searchResults[0].json.id) {\n  return [{\n    json: {\n      clientId: searchResults[0].json.id,\n      isNew: false,\n      domaine: emailData.domaine,\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    clientId: null,\n    isNew: true,\n    domaine: emailData.domaine,\n  },\n}];"
      }
    },
    {
      "id": "5",
