    {
      "id": "23",
      "name": "Préparer Uploads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4420, 300],
      "parameters": {
        "jsCode": "const folderId = $input.first().json.folderId;\n\nreturn $('Extraire Pièces Jointes').all().map((pj) => ({\n  json: { ...pj.json, folderId },\n  binary: pj.binary,\n}));"
      }
    },
    {
      "id": "17",
      "name": "Drive - Upload Fichier",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [4640, 300],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
